# Production placeholders only. Do not commit a populated copy.
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:mysql://<rds-endpoint>:3306/ewallet_db?<tls-options>
DB_USERNAME=<database-username>
DB_PASSWORD=<database-password>
JWT_SECRET=<at-least-32-random-bytes>
JWT_EXPIRATION=3600
FRONTEND_BASE_URL=https://<frontend-hostname>
CORS_ALLOWED_ORIGINS=https://<frontend-hostname>
EMAIL_VERIFICATION_MINUTES=1440
PASSWORD_RESET_MINUTES=30
MAIL_DEVELOPMENT_LOG_ENABLED=false
SES_SMTP_HOST=email-smtp.<aws-region>.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USERNAME=<ses-smtp-username>
SES_SMTP_PASSWORD=<ses-smtp-password>
MAIL_FROM_ADDRESS=<verified-sender@example.com>
