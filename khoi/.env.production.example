# Production placeholders only. Do not commit a populated copy.
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:mysql://your-rds-endpoint:3306/ewallet_db
DB_USERNAME=replace-with-database-username
DB_PASSWORD=replace-with-database-password
JWT_SECRET=replace-with-at-least-32-byte-secret
JWT_EXPIRATION=3600
FRONTEND_BASE_URL=https://cloud-ewallet.com
CORS_ALLOWED_ORIGINS=https://cloud-ewallet.com
EMAIL_VERIFICATION_MINUTES=1440
PASSWORD_RESET_MINUTES=30
MAIL_DEVELOPMENT_LOG_ENABLED=false
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=replace-with-resend-api-key
MAIL_FROM_ADDRESS=no-reply@cloud-ewallet.com
