# =========================================================
# APPLICATION PROFILE
# =========================================================

# Use "prod" for the production environment.
SPRING_PROFILES_ACTIVE=prod


# =========================================================
# DATABASE — AMAZON RDS MYSQL
# =========================================================

# Full JDBC connection string to the production MySQL database.
# Example:
# jdbc:mysql://your-rds-endpoint.ap-southeast-1.rds.amazonaws.com:3306/ewallet?useUnicode=true&characterEncoding=UTF-8&useSSL=true&requireSSL=true&serverTimezone=UTC
DB_URL=jdbc:mysql://YOUR_RDS_ENDPOINT:3306/YOUR_DATABASE_NAME?useUnicode=true&characterEncoding=UTF-8&useSSL=true&requireSSL=true&serverTimezone=UTC

# RDS master username or application database username.
DB_USERNAME=YOUR_DATABASE_USERNAME

# RDS database password.
# Never commit the real password to Git.
DB_PASSWORD=YOUR_DATABASE_PASSWORD


# =========================================================
# JWT AUTHENTICATION
# =========================================================

# Secret used to sign JWT access tokens.
# Use a strong random value of at least 32 bytes.
# Never reuse a password or commit the real value.
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_32_BYTES

# Access-token lifetime in seconds.
# 3600 seconds = 1 hour.
JWT_EXPIRATION=3600


# =========================================================
# FRONTEND AND CORS
# =========================================================

# Public frontend URL used in verification and password-reset links.
# Do not add a trailing slash.
FRONTEND_BASE_URL=https://cloud-ewallet.com

# Comma-separated list of origins allowed to call the backend.
# For the current production website:
CORS_ALLOWED_ORIGINS=https://cloud-ewallet.com

# Multiple origins example:
# CORS_ALLOWED_ORIGINS=https://cloud-ewallet.com,https://www.cloud-ewallet.com


# =========================================================
# ACCOUNT EMAIL FLOW
# =========================================================

# false: send real emails through the configured SMTP provider.
# true: development mode may log email links instead of sending them.
# Production must use false.
MAIL_DEVELOPMENT_LOG_ENABLED=false

# Email verification token lifetime in minutes.
# 1440 minutes = 24 hours.
EMAIL_VERIFICATION_MINUTES=1440

# Password-reset token lifetime in minutes.
PASSWORD_RESET_MINUTES=30


# =========================================================
# RESEND SMTP
# =========================================================

# Resend SMTP server.
SMTP_HOST=smtp.resend.com

# Resend STARTTLS port.
SMTP_PORT=587

# Resend SMTP username.
# Resend normally uses the literal value "resend".
SMTP_USERNAME=resend

# Resend API key used as the SMTP password.
# Never commit the real key.
SMTP_PASSWORD=REPLACE_WITH_YOUR_RESEND_API_KEY


# =========================================================
# OUTGOING EMAIL ADDRESS
# =========================================================

# Sender address must belong to a domain verified in Resend.
MAIL_FROM_ADDRESS=noreply@cloud-ewallet.com